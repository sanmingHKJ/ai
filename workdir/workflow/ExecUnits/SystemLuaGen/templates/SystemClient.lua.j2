-- ========== CONSTRUCTOR ==========
function {{system_name}}Client.new(sgf)
    local self = setmetatable({}, {__index = {{system_name}}Client})

    -- Store framework reference
    self.sgf = sgf
    self.log = sgf.log
    self.events = sgf.events

    -- Initialize data structures
    self.data = {}
    self.localState = {}
    self.dependencies_cache = {}
    self.ui = {}

    return self
end

-- ========== LIFECYCLE PHASE 1: PREINIT ==========
--[[
    PreInit - Register event listeners

    Called FIRST, before other systems exist.
    DO NOT access other systems here.
]]
function {{system_name}}Client:PreInit()
    self.log:info("[{{system_name}}Client] PreInit started")

    -- Register event handlers
    self:registerEventListeners()

    self.log:info("[{{system_name}}Client] PreInit complete")
    return true
end

-- ========== LIFECYCLE PHASE 2: INIT ==========
--[[
    Init - Initialize system, register network handlers

    Called SECOND, after all PreInit.
    DO NOT access other systems here (use PostInit).
]]
function {{system_name}}Client:Init()
    self.log:info("[{{system_name}}Client] Init started")

    -- Load configuration
    self.config = {
        -- TODO: Add configuration values
    }

    {% if has_network %}
    -- Register network handlers
    self:registerNetworkHandlers()
    {% endif %}

    -- Initialize UI
    self:initializeUI()

    -- Initialize local state
    self:initializeState()

    self.state = "initialized"
    self.log:info("[{{system_name}}Client] Init complete")
    return true
end

-- ========== LIFECYCLE PHASE 3: POSTINIT ==========
--[[
    PostInit - Resolve dependencies on other systems

    Called THIRD, after all Init.
    NOW safe to access other systems.
]]
function {{system_name}}Client:PostInit()
    self.log:info("[{{system_name}}Client] PostInit started")

    -- Get dependency references
    {% for dep in dependencies %}
    self.dependencies_cache.{{dep}} =
        self.sgf.businessSystemManager:get("{{dep}}Client")

    if not self.dependencies_cache.{{dep}} then
        self.log:error("[{{system_name}}Client] Missing dependency: {{dep}}Client")
        return false
    end
    {% endfor %}

    self.log:info("[{{system_name}}Client] PostInit complete")
    return true
end

-- ========== LIFECYCLE PHASE 4: START ==========
--[[
