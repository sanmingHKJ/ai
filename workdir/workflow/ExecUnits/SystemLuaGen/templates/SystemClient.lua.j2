-- ========== EVENT BUS ==========
function {{system_name}}Client:registerEventListeners()
    local EventID = require(script.Parent.Parent.Parent.Runtime.EventID)

    {% for behavior in behaviors %}
    {% if behavior.trigger.type == "event" %}
    -- Behavior: {{behavior.id}}
    self.events:on(EventID.{{behavior.trigger.name}}, function(data)
        self:{{behavior.handler_method}}(data)
    end)
    {% endif %}
    {% endfor %}
end

{% if has_network %}
-- ========== NETWORK HANDLERS ==========
function {{system_name}}Client:registerNetworkHandlers()
    -- Register as network object
    local NetworkHelper = require(script.Parent.Parent.Parent.GamePlay.NetworkHelper)
    NetworkHelper:RegisterNetObj(self)

    -- Import protocol definitions
    local Protocol = require(script.Parent.Parent.Parent.Runtime.Protocol)

    {% for response in server_responses %}
    -- Server response: {{response.id}}
    self:OnResponse(Protocol.ServerMSGID.{{response.message_id}}, function(msgid, data)
        self:{{response.method_name}}(data)
    end)
    {% endfor %}

    self.log:info("[{{system_name}}Client] Network handlers registered")
end

{% for action in player_actions %}
-- Player Action Request: {{action.id}}
-- Sends request to server
function {{system_name}}Client:{{action.method_name}}({% if action.params %}{{action.params|join(', ')}}{% endif %})
    self.log:debug("[{{system_name}}Client] Sending {{action.id}} request to server")

    local Protocol = require(script.Parent.Parent.Parent.Runtime.Protocol)

    local requestData = {
        {% for param in action.params %}
        {{param}} = {{param}},
        {% endfor %}
    }

    -- Send to server via CallServer (provided by NetworkHelper)
    self:CallServer(Protocol.ClientMSGID.{{action.message_id}}, requestData, function(response)
        if response and response.success then
            self.log:info("[{{system_name}}Client] {{action.id}} succeeded")
            -- TODO: Handle successful response
        else
            self.log:warning("[{{system_name}}Client] {{action.id}} failed: " .. tostring(response and response.error))
        end
    end)
end

{% endfor %}

